# 使用 MySQL，按实际账号、密码及数据库名修改。
DATABASE_URL=mysql+pymysql://course_user:change_me@127.0.0.1:3306/learning_diagnosis?charset=utf8mb4
RAG_URL=http://127.0.0.1:8001
SERVICE_TIMEOUT=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 使用 python -c 'import secrets; print(secrets.token_hex(32))' 生成独立密钥。
EMAIL_VERIFICATION_SECRET=
# 邮箱服务商提供的 SMTP 地址、账号和授权码；不填写真实凭据到示例文件。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 留空时使用 SMTP_USERNAME。
SMTP_FROM=
# ssl 或 starttls，以邮件服务商要求为准。
SMTP_SECURITY=ssl
SMTP_TIMEOUT=10

RESOURCE_UPLOAD_DIR=data/resource_files

# C/D 调用 B 的独立服务凭证。各自生成至少 32 字节且互不相同的随机密钥。
# python -c 'import secrets; print(secrets.token_hex(32))'
# 留空或过短时内部接口关闭；不是用户登录返回的 Token。
C_SERVICE_KEY=
D_SERVICE_KEY=
# 显式允许访问的课程 ID，英文逗号分隔；空白无权限，* 允许所有课程（含以后新增课程）。
C_SERVICE_COURSE_IDS=
D_SERVICE_COURSE_IDS=

# 正常提交及超时结算时，自动持久化诊断通知；仅入队，不等待 D。
DIAGNOSIS_AUTO_ENQUEUE=true
# B→D 的任务接收地址与独立密钥；D 需实现 POST /internal/diagnosis-tasks。
# 密钥至少 32 字节，与 C_SERVICE_KEY、D_SERVICE_KEY 不同，并在 D 配置同一接收密钥。
DIAGNOSIS_URL=http://127.0.0.1:8002
DIAGNOSIS_SERVICE_KEY=
DIAGNOSIS_TIMEOUT=10
DIAGNOSIS_MAX_ATTEMPTS=5
# 入队后需单独运行：python -m app.dispatch_diagnoses --watch
