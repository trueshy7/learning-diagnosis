RAG_HOST=127.0.0.1
RAG_PORT=8001
RAG_DATA_PATH=data/catalog.json
RAG_SEED_ON_START=true
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60
RAG_BACKEND=keyword
RAG_KEYWORD_MIN_SCORE=0.20
RAG_MAX_EVIDENCE_CHARS=6000
RAG_FALLBACK=true
# 安装 requirements-chroma.txt 并准备模型后，设置 RAG_BACKEND=chroma
RAG_CHROMA_PATH=data/chroma
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_REVISION=46fbe35fd4374a00fee7de77dfddaeb6dd6a2c59
RAG_EMBEDDING_DIMENSION=512
RAG_MODEL_CACHE=data/models
RAG_MODEL_PATH=data/models/bge-local
RAG_MIN_SCORE=0.45
RAG_BATCH_SIZE=32
RAG_TIMEOUT_SECONDS=30
# 可选 HTTP Embedding；URL 指向完整 embeddings 接口，不含真实密钥
RAG_EMBEDDING_URL=
RAG_EMBEDDING_KEY=
# B 主动拉取适配，凭证与 B 的 C_SERVICE_KEY 一致
# 正式同步建议使用 data/backend-catalog.json 和 data/backend-chroma 避免混入本地语料副本
B_URL=http://127.0.0.1:8000
B_C_KEY=
RAG_SYNC_ON_START=false
RAG_SYNC_INTERVAL=30
# 正式接 ts 时建议关闭旧种子并限定实际课程
# RAG_SEED_ON_START=false
RAG_ALLOWED_COURSE_IDS=*
# C 的接收端可选凭证，启用后 D 需增加 Authorization 头
RAG_SERVICE_KEY=
