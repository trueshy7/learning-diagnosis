# 复制为 .env 后启动；自动读取启动目录的 .env，系统环境变量优先。
# mock：内置演示证据；http：调用成员 C 的真实本地检索服务。
RAG_MODE=mock
RAG_BASE_URL=http://127.0.0.1:8001
RAG_TIMEOUT_SECONDS=5

# 默认不调用模型。使用 DeepSeek 时改为 deepseek，并在本机环境设置 DEEPSEEK_API_KEY。
LLM_MODE=disabled
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_KEY 不写在仓库文件中，只在运行机器的环境变量里设置。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20

